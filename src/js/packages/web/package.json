{
    "name": "@fnnx-ai/web",
    "version": "0.0.2",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "lint": "eslint src tests vitest.config.ts playwright.config.ts global.d.ts",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\" \"global.d.ts\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@fnnx-ai/common": "workspace:*",
        "onnxruntime-web": "^1.20.1"
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "happy-dom": "^20.6.1",
        "http-server": "^14.1.1",
        "vitest": "^4.0.18"
    }
}
