{
    "name": "@fnnx-ai/web",
    "version": "0.1.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/BeastByteAI/FNNX.git",
        "directory": "src/js/packages/web"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "lint": "eslint src tests vitest.config.ts playwright.config.ts global.d.ts",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\" \"global.d.ts\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@fnnx-ai/common": "workspace:*",
        "onnxruntime-web": "^1.20.1"
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "happy-dom": "^20.6.1",
        "http-server": "^14.1.1",
        "vitest": "^4.0.18"
    }
}
